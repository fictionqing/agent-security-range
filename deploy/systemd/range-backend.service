[Unit]
Description=Agent Security Range API (Mock)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/range/backend
Environment=PYTHONPATH=/home/ubuntu/range/backend
Environment=RANGE_API_HOST=0.0.0.0
Environment=RANGE_API_PORT=8801
Environment=RANGE_API_RELOAD=0
ExecStart=/home/ubuntu/range/backend/.venv/bin/python -m uvicorn api.main:app --host 0.0.0.0 --port 8801
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
