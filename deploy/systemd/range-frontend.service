[Unit]
Description=Agent Security Range Next.js frontend
After=network.target range-backend.service
Wants=range-backend.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/range/agent-security-range
Environment=PATH=/home/ubuntu/.local/node-v22.19.0-linux-x64/bin:/usr/bin:/bin
EnvironmentFile=-/home/ubuntu/range/agent-security-range/.env.local
ExecStart=/home/ubuntu/.local/node-v22.19.0-linux-x64/bin/npm run start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
